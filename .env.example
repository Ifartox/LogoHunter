# Token del bot Telegram fornito da @BotFather
TELEGRAM_BOT_TOKEN=il_tuo_token_telegram_qui

# Il tuo ID utente Telegram numerico (per ricevere notifiche solo tu)
TELEGRAM_CHAT_ID=il_tuo_chat_id_numerico

# Configurazione del server di invio email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=latuaemail@gmail.com
SMTP_PASSWORD=la_tua_app_password_generata

# Indirizzo mittente mostrato nell'email
SENDER_EMAIL=latuaemail@gmail.com

# Percorso relativo o assoluto del tuo file CV in PDF
CV_FILE_PATH=cv/curriculum_vitae.pdf
